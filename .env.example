# Info Drill Environment Configuration
# Base API URL for backend microservices
VITE_API_BASE_URL=https://api.infodrill.com/v1

# Application metadata
VITE_APP_NAME=Info Drill
VITE_APP_ENV=development
VITE_APP_URL=https://infodrill.com

# InfoDrill AI Assistant Chatbot (Backend LLM API Key)
